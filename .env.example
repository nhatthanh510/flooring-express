# Absolute origin the site is served from, with no trailing slash.
#
# This drives `metadataBase`, canonical links, the sitemap and — most visibly —
# the absolute `og:image` URL that Facebook, LinkedIn, Slack, X and iMessage
# fetch when someone shares a link. If it points at a host that isn't serving
# the site, the preview shows the title and description with no image.
#
# Leave unset on Vercel: the deployment URL is detected automatically.
# Set it when self-hosting, or when testing shares through a tunnel, e.g.
#
#   NEXT_PUBLIC_SITE_URL=https://your-subdomain.trycloudflare.com
#
NEXT_PUBLIC_SITE_URL=https://flooringexpress.com.au

# ---------------------------------------------------------------------------
# Sanity
# ---------------------------------------------------------------------------
# All site content lives in Sanity. `pnpm dlx sanity@latest init` writes the
# project id for you; the dataset is `production` unless you chose otherwise.
# The two NEXT_PUBLIC_ values are safe to expose — they identify a dataset whose
# published documents are already world-readable.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Pin the API version to the date you started, so a future Sanity API change
# can never alter query results underneath a deployed build. Bump deliberately.
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-29

# Read token with **Viewer** rights, from sanity.io/manage → API → Tokens.
# Powers draft-mode previews and the Live Content API. It is handed to the
# browser by `<SanityLive />` when draft mode is on, so it must never have
# write access.
SANITY_API_READ_TOKEN=

# Write token with **Editor** rights. Used ONLY by `pnpm migrate:sanity` to seed
# content and upload the image assets — nothing under `src/` ever reads it.
# Safe to delete from your env once the migration has run.
SANITY_API_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Resend — quote form delivery
# ---------------------------------------------------------------------------
# Without both of these, /api/quote refuses the submission and logs an error:
# enquiries are never silently dropped.
#
# API key from resend.com/api-keys. Sending permission is all it needs.
RESEND_API_KEY=

# The From address. Must be on a domain verified in Resend, or delivery fails —
# which is why this is env and not CMS content. A display name is allowed:
#
#   RESEND_FROM="Flooring Express <quotes@flooringexpress.com.au>"
#
# It CANNOT be an @gmail.com address. Gmail publishes a strict DMARC policy, so
# mail claiming to come from gmail.com but sent through Resend is rejected or
# filed as spam. Verify your own domain at resend.com/domains. For a quick test
# before the domain is verified, Resend allows `onboarding@resend.dev`, which
# only ever delivers to the email on your Resend account.
#
# Where enquiries LAND is set in Sanity, not here: Site settings → Contact &
# hours → "Where quote enquiries are sent". That field is private and may be a
# Gmail address. Left empty, it falls back to the public contact email.
RESEND_FROM=
